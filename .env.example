# Copy to .env (`cp .env.example .env`). docker compose reads it automatically.
# Every variable is optional; the values below are the defaults.

# Host port the API is published on -> http://localhost:${API_PORT}
API_PORT=8000
LOG_LEVEL=INFO

# --- Storage (only for running outside Docker; compose points these at its own containers)
# MONGO_URL=mongodb://localhost:27017
# MONGO_DB=cohort_insights
# REDIS_URL=redis://localhost:6379/0
# MONGO_TIMEOUT_MS=3000      # server selection timeout
# REDIS_TIMEOUT_S=0.5        # short on purpose: a slow Redis triggers the MongoDB fallback quickly

# --- Rate limit: max documents per user in queued|processing|enriching
MAX_ACTIVE_PER_USER=3
ACTIVE_SET_TTL_S=3600        # safety TTL on the per-user active set (refreshed on every acquire)

# --- Content cache
CACHE_TTL_S=604800           # 7 days; MongoDB remains the source of truth after expiry

# --- Pipeline
EMBEDDED_WORKERS=false       # true = run workers inside the API process (local dev without the worker service)
WORKER_CONCURRENCY=3         # stage executions per worker process (= processing capacity)
STAGE_LEASE_S=60             # a crashed worker's stage becomes claimable again after this
STAGE_TIME_SCALE=1           # multiplier on simulated stage durations and backoff (tests use ~0.01)
FAILURE_RATE=0.1             # simulated failure probability per stage attempt
MAX_STAGE_ATTEMPTS=3         # attempts per stage before the document is marked failed
RETRY_BASE_DELAY_S=1         # backoff: base * 2^(attempt-1), +/-50% jitter
